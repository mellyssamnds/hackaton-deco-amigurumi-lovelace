# --- Parte 2: nestjs-worker/processing ---

# Porta do servidor HTTP (health check)
PORT=3000

# Cloudflare Queue - HTTP Pull Consumer
# Conta e fila criadas na Parte 1 (cloudflare-worker)
CF_ACCOUNT_ID=
CF_QUEUE_ID=beatriz-orders
CF_API_TOKEN=
CF_QUEUE_POLL_INTERVAL_MS=5000
CF_QUEUE_BATCH_SIZE=10
CF_QUEUE_VISIBILITY_TIMEOUT_MS=30000

# Nuvemshop API - busca do pedido completo
NUVEMSHOP_STORE_ID=
NUVEMSHOP_ACCESS_TOKEN=
NUVEMSHOP_API_BASE_URL=https://api.nuvemshop.com.br/v1

# Retry ao buscar pedido / publicar job
ORDER_FETCH_MAX_RETRIES=3
ORDER_FETCH_RETRY_BASE_DELAY_MS=500

# Integração com a Parte 3 (watermark-email) - POST /watermark-jobs
# Em Docker Compose, "watermark-email" é o hostname do serviço na rede
# interna (ver docker-compose.yml). Fora do Compose, aponte para
# http://localhost:3001.
WATERMARK_EMAIL_URL=http://watermark-email:3001
WATERMARK_DISPATCH_MAX_RETRIES=3
WATERMARK_DISPATCH_RETRY_BASE_DELAY_MS=500
