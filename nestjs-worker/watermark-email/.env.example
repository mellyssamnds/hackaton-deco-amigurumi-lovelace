# --- Parte 3: nestjs-worker/watermark-email ---

# Porta do servidor HTTP (health check + endpoint de recebimento do job)
PORT=3001

# Onde estao os PDFs originais dos e-books.
# Hoje: volume Docker local, um arquivo por product_id (assets/ebooks/{product_id}.pdf).
# EbookAssetSource esta preparado para trocar por R2/S3 sem mudar o resto do fluxo.
EBOOKS_DIR=../assets/ebooks

# Resend - envio do e-book marcado por e-mail
RESEND_API_KEY=
RESEND_FROM_EMAIL=entregas@amigurumilovelace.com.br

# Retry no envio do e-mail (nao perder o pedido em caso de falha temporaria do Resend)
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BASE_DELAY_MS=500

# Google Gemini — seleção inteligente de marca d'água (US16) e e-mail dinâmico (US17)
# Obter chave gratuita em: https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_MS=8000
